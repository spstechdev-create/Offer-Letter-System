DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR_AUTH_HOST/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
APP_URL=http://localhost:3000
