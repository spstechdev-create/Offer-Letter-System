{
  "name": "sps-offer-letter-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "user:provision": "node --env-file=.env.local scripts/provision-user.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
